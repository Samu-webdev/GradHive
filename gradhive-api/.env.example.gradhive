# À fusionner dans le .env généré par Laravel
APP_NAME=GradHive
APP_LOCALE=fr
APP_URL=http://localhost:8000

# --- Base de données : PostgreSQL (Neon) ---
DB_CONNECTION=pgsql
DB_HOST=ep-xxxxxx.eu-central-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=gradhive
DB_USERNAME=neondb_owner
DB_PASSWORD=change-me
DB_SSLMODE=require

# --- GradHive ---
CORS_ALLOWED_ORIGINS=http://localhost:4200   # production : https://votre-site.vercel.app (jamais *)

# --- Sécurité des jetons ---
TOKEN_TTL_MINUTES=480

# --- Stockage des PDF ---
# Développement : disque local.   Production : S3 / Cloudflare R2 (voir CORRECTIFS.md).
GRADHIVE_FILES_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=gradhive-pdf
# AWS_ENDPOINT=https://<compte>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true
